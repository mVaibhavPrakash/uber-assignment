{
    "name": "mobility-control-room",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:sample": "vite --mode rain-demo",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "npm run lint:fix && npm run format",
        "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "format:check": "prettier --check \"./**/*.{js,jsx,ts,tsx,json,css,md}\""
    },
    "dependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "eslint": "^9.14.0",
        "eslint-config-prettier": "^9.1.0",
        "globals": "^16.5.0",
        "prettier": "^3.3.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^7.2.2"
    }
}
