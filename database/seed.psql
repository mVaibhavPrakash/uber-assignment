-- Run from the repository root. Reset is opt-in and limited to assignment tables.
\set ON_ERROR_STOP on
\if :{?reset}
\else
  \set reset false
\endif
SELECT :'reset'::boolean AS reset \gset

BEGIN;
SET LOCAL statement_timeout = '30min';
SET LOCAL lock_timeout = '15s';
SELECT pg_advisory_xact_lock(73192027);
DO $$
BEGIN
    IF current_database() <> 'mobility_control_room' OR current_schema() <> 'public' THEN
        RAISE EXCEPTION 'Setup requires the dedicated mobility_control_room database and public schema';
    END IF;
END $$;

\if :reset
  DO $$
  BEGIN
      IF EXISTS (SELECT 1 FROM pg_stat_activity WHERE datname = current_database()
                 AND pid <> pg_backend_pid() AND backend_type = 'client backend') THEN
          RAISE EXCEPTION 'Stop the application and other database clients before resetting';
      END IF;
  END $$;
  DROP TABLE IF EXISTS weather_forecasts, historical_observations, community_areas;
\endif

SELECT count(*) = 0 AS create_schema, count(*) NOT IN (0, 3) AS partial_schema
FROM information_schema.tables
WHERE table_schema = 'public'
  AND table_name IN ('community_areas', 'historical_observations', 'weather_forecasts')
\gset
\if :partial_schema
  DO $$ BEGIN RAISE EXCEPTION 'Partial assignment schema found; use an explicit reset'; END $$;
\endif
\if :create_schema
  \ir migrations/000001_init.up.sql
\endif

LOCK TABLE community_areas, historical_observations, weather_forecasts IN ACCESS EXCLUSIVE MODE;
DO $$
BEGIN
    IF EXISTS (SELECT 1 FROM community_areas)
       OR EXISTS (SELECT 1 FROM historical_observations)
       OR EXISTS (SELECT 1 FROM weather_forecasts) THEN
        RAISE EXCEPTION 'Database already contains data; use an explicit reset only for the assignment database';
    END IF;
END $$;

\copy community_areas (id, name, latitude, longitude) FROM 'data/public/areas.csv' WITH (FORMAT csv, HEADER MATCH, NULL '\N', ENCODING 'UTF8')
\copy historical_observations (area_id, hour_start, local_date, day_of_week, season, hour_of_day, trip_count, rain_mm, snowfall_cm, temperature_c, apparent_temperature_c, precipitation_mm, wind_speed_kmh) FROM 'data/public/historical_observations.csv' WITH (FORMAT csv, HEADER MATCH, NULL '\N', ENCODING 'UTF8')
COMMIT;
\echo CSV imports committed. If statistics refresh fails, do not rerun setup without inspecting the database.
ANALYZE community_areas, historical_observations, weather_forecasts;
