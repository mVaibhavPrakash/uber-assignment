-- Run from the repository root. Reset is opt-in and limited to assignment tables.
\set ON_ERROR_STOP on
\if :{?reset}
\else
  \set reset false
\endif
SELECT :'reset'::boolean AS reset \gset

BEGIN;
SET LOCAL statement_timeout = '30min';
SET LOCAL lock_timeout = '15s';
SELECT pg_advisory_xact_lock(73192027);
DO $$
BEGIN
    IF current_database() <> 'mobility_control_room' OR current_schema() <> 'public' THEN
        RAISE EXCEPTION 'Setup requires the dedicated mobility_control_room database and public schema';
    END IF;
END $$;

\if :reset
  DO $$
  BEGIN
      IF EXISTS (SELECT 1 FROM pg_stat_activity WHERE datname = current_database()
                 AND pid <> pg_backend_pid() AND backend_type = 'client backend') THEN
          RAISE EXCEPTION 'Stop the application and other database clients before resetting';
      END IF;
  END $$;
  DROP TABLE IF EXISTS weather_forecasts, historical_observations, community_areas;
\endif

SELECT count(*) = 0 AS create_schema, count(*) NOT IN (0, 3) AS partial_schema
FROM information_schema.tables
WHERE table_schema = 'public'
  AND table_name IN ('community_areas', 'historical_observations', 'weather_forecasts')
\gset
\if :partial_schema
  DO $$ BEGIN RAISE EXCEPTION 'Partial assignment schema found; use an explicit reset'; END $$;
\endif
\if :create_schema
  \ir migrations/000001_init.up.sql
\else
  -- Older installations stored a derived season. Upgrade them in the seed transaction.
  SELECT EXISTS (SELECT FROM information_schema.columns
                 WHERE table_schema = 'public' AND table_name = 'historical_observations'
                   AND column_name = 'season') AS has_season \gset
  \if :has_season
    ALTER TABLE public.historical_observations DROP COLUMN season;
  \endif
\endif

-- Stage the CSVs so repeat setup can verify every field without overwriting data.
CREATE TEMP TABLE seed_areas (LIKE community_areas) ON COMMIT DROP;
CREATE TEMP TABLE seed_observations (LIKE historical_observations) ON COMMIT DROP;
\copy seed_areas (id, name, latitude, longitude) FROM 'data/public/areas.csv' WITH (FORMAT csv, HEADER MATCH, NULL '\N', ENCODING 'UTF8')
\copy seed_observations FROM 'data/public/historical_observations.csv' WITH (FORMAT csv, HEADER MATCH, NULL '\N', ENCODING 'UTF8')

-- Keep data stable during verification while allowing the running API to read it.
LOCK TABLE community_areas, historical_observations, weather_forecasts IN SHARE ROW EXCLUSIVE MODE;
SELECT NOT EXISTS (SELECT 1 FROM community_areas)
   AND NOT EXISTS (SELECT 1 FROM historical_observations)
   AND NOT EXISTS (SELECT 1 FROM weather_forecasts) AS load_seed \gset

\if :load_seed
  INSERT INTO community_areas SELECT * FROM seed_areas;
  INSERT INTO historical_observations SELECT * FROM seed_observations;
\else
  DO $$
  BEGIN
      IF EXISTS (
          (TABLE community_areas EXCEPT ALL TABLE seed_areas)
          UNION ALL
          (TABLE seed_areas EXCEPT ALL TABLE community_areas)
      ) OR EXISTS (
          (TABLE historical_observations EXCEPT ALL TABLE seed_observations)
          UNION ALL
          (TABLE seed_observations EXCEPT ALL TABLE historical_observations)
      ) THEN
          RAISE EXCEPTION 'Existing assignment data is partial or differs from the bundled CSVs; inspect it before an explicit reset';
      END IF;
  END $$;
\endif
COMMIT;
\if :load_seed
  \echo CSV imports committed. Refreshing database statistics.
  ANALYZE community_areas, historical_observations, weather_forecasts;
  \echo Setup complete.
\else
  \echo Database already initialized; skipping seed.
\endif
