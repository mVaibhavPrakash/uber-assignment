-- Run from the repository root. Reset is opt-in and limited to assignment tables.
\set ON_ERROR_STOP on
\if :{?reset}
\else
  \set reset false
\endif
SELECT :'reset'::boolean AS reset \gset

BEGIN;
DO $$ BEGIN
    IF current_database() <> 'mobility_control_room' OR current_schema() <> 'public' THEN
        RAISE EXCEPTION 'Setup requires the dedicated mobility_control_room database and public schema';
    END IF;
END $$;
SELECT pg_advisory_xact_lock(73192027);

\if :reset
  DROP TABLE IF EXISTS weather_forecasts, historical_observations, community_areas;
\endif

SELECT count(*) = 0 AS create_schema, count(*) NOT IN (0, 3) AS partial_schema
FROM information_schema.tables
WHERE table_schema = 'public'
  AND table_name IN ('community_areas', 'historical_observations', 'weather_forecasts')
\gset
\if :partial_schema
  DO $$ BEGIN RAISE EXCEPTION 'Partial assignment schema: expected all three tables or none'; END $$;
\endif
\if :create_schema
  \ir migrations/000001_init.up.sql
\endif

WITH seed_state AS (
    SELECT EXISTS (SELECT FROM community_areas) AS has_areas,
           EXISTS (SELECT FROM historical_observations) AS has_history
)
SELECT has_areas AND has_history AS initialized, has_areas <> has_history AS partial_data
FROM seed_state \gset
\if :partial_data
  DO $ BEGIN RAISE EXCEPTION 'Partial seed data: community areas and historical observations must both be populated or both be empty'; END $;
\endif
\if :initialized
  COMMIT;
  \echo Database already initialized; skipping seed.
  \quit
\endif

\copy community_areas (id, name, latitude, longitude) FROM 'data/public/areas.csv' WITH (FORMAT csv, HEADER MATCH, NULL '\N', ENCODING 'UTF8')
\copy historical_observations (area_id, hour_start, local_date, day_of_week, hour_of_day, trip_count, rain_mm, snowfall_cm, temperature_c, apparent_temperature_c, precipitation_mm, wind_speed_kmh) FROM 'data/public/historical_observations.csv' WITH (FORMAT csv, HEADER MATCH, NULL '\N', ENCODING 'UTF8')
COMMIT;
ANALYZE community_areas, historical_observations;
\echo Setup complete.
